# 通义千问API Key
DASHSCOPE_API_KEY=your_api_key_here

# 阿里云AccessKey（用于发票验真服务）
# 获取步骤：
# 1. 访问：https://ram.console.aliyun.com/manage/ak
# 2. 创建AccessKey，得到 AccessKey ID 和 AccessKey Secret
# 3. 开通OCR发票核验服务：https://help.aliyun.com/zh/ocr/product-overview/ticket-and-invoice-verification-1
# 4. 免费额度：50次
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here

# 和风天气API Key（可选）
QWEATHER_API_KEY=your_weather_api_key_here

# 飞书配置
# 飞书群机器人 Webhook Key（用于推送卡片消息，不支持回调）
# 获取步骤：
# 1. 在飞书群聊中添加自定义机器人
# 2. 复制 Webhook 地址中的 key 部分
# 示例：https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#       则 FEISHU_WEBHOOK_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK_KEY=your_feishu_webhook_key_here

# 飞书应用凭证（用于消息API，支持回调交互）★推荐★
# 获取步骤：
# 1. 访问飞书开放平台：https://open.feishu.cn/app
# 2. 创建企业自建应用
# 3. 在"凭证与基础信息"中获取 App ID 和 App Secret
# 4. 开通权限：发送消息(im:message)、获取用户信息、互动卡片回调
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here

# 飞书群聊ID（用于发送消息）
# 获取步骤：运行 python get_chat_id.py 获取群聊ID
# 示例：oc_f4b85703576e1fcd986ac22399cb65eb
FEISHU_CHAT_ID=your_feishu_chat_id_here

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=business_trip
DB_USER=postgres
DB_PASSWORD=your_password_here

# 连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT密钥（生产环境必须修改！）
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# 服务配置
HOST=0.0.0.0
PORT=8000

# 日志级别
LOG_LEVEL=INFO
