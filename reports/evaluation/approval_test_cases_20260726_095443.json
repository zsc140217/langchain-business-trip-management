      }
    },
    {
      "test_id": "TC_021",
      "category": "boundary",
      "description": "超长目的地: 100字符",
      "input": {
        "destination": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "days": 3,
        "estimated_amount": 800,
        "purpose": "培训"
      },
      "expected": {
        "validation": "pass",
        "approval_path": "auto"
      }
    },
    {
      "test_id": "TC_022",
      "category": "approval_path",
      "description": "自动审批路径: 金额<阈值",
      "input": {
        "destination": "成都",
        "days": 2,
        "estimated_amount": 600,
        "purpose": "客户拜访"
      },
      "expected": {
        "approval_path": "auto",
        "status": "approved",
        "validation": "pass"
      }
    },
    {
      "test_id": "TC_023",
      "category": "approval_path",
      "description": "人工审批路径: 金额>=阈值",
      "input": {
        "destination": "深圳",
        "days": 5,
        "estimated_amount": 3000,
        "purpose": "项目实施"
      },
      "expected": {
        "approval_path": "manual",
        "status": "pending",
        "validation": "pass"
      }
