{
  "metadata": {
    "version": "1.0",
    "total_cases": 50,
    "description": "RAG检索质量测试用例集",
    "evaluation_metrics": [
      "precision",
      "recall",
      "f1_score",
      "mrr",
      "ndcg"
    ],
    "categories": {
      "policy_query": "政策查询类（标准明确）",
      "procedure_query": "流程查询类（步骤清晰）",
      "complex_scenario": "复杂场景类（多条件组合）",
      "exception_handling": "异常处理类（特殊情况）",
      "multi_city": "多城市出差",
      "international": "国际出差"
    },
    "difficulty_levels": {
      "easy": "单一条件，直接匹配",
      "medium": "2-3个条件，需要推理",
      "hard": "多条件组合，需要深度理解"
    }
  },
  "test_cases": [
    {
      "id": "RAG_001",
      "category": "policy_query",
      "query": "出差住宿费用标准是多少？",
      "expected_chunks": [
        "accommodation_policy_standard",
        "expense_limits_by_city_tier"
      ],
      "ground_truth_answer": "住宿费用标准按城市等级划分：一线城市500元/晚，二线城市400元/晚，三线及以下城市300元/晚",
      "difficulty": "easy"
    },
    {
      "id": "RAG_002",
      "category": "policy_query",
      "query": "总监级别去上海出差可以住多少钱的酒店？",
      "expected_chunks": [
        "accommodation_policy_by_level",
        "city_tier_classification"
      ],
      "ground_truth_answer": "总监级别在上海（一线城市）的住宿标准为800元/晚",
      "difficulty": "medium"
    },
    {
      "id": "RAG_003",
      "category": "policy_query",
      "query": "飞机票什么时候可以坐头等舱？",
      "expected_chunks": [
        "flight_class_policy",
        "executive_travel_privileges"
      ],
      "ground_truth_answer": "VP及以上级别，或航程超过4小时的国际航班可以乘坐头等舱",
      "difficulty": "medium"
    },
    {
      "id": "RAG_004",
      "category": "procedure_query",
      "query": "出差申请需要提前多久提交？",
      "expected_chunks": [
        "trip_application_timeline",
        "approval_process_overview"
      ],
      "ground_truth_answer": "国内出差需提前3个工作日，国际出差需提前7个工作日提交申请",
      "difficulty": "easy"
    },
    {
      "id": "RAG_005",
      "category": "procedure_query",
      "query": "出差报销需要提供哪些材料？",
      "expected_chunks": [
        "reimbursement_required_documents",
        "receipt_requirements"
      ],
      "ground_truth_answer": "需提供：出差申请单、交通票据、住宿发票、餐饮发票（如有）、其他费用凭证",
      "difficulty": "easy"
    },
    {
      "id": "RAG_006",
      "category": "exception_handling",
      "query": "出差期间生病了怎么报销医疗费？",
      "expected_chunks": [
        "emergency_medical_policy",
        "exceptional_expense_handling"
      ],
      "ground_truth_answer": "出差期间因突发疾病产生的医疗费用，凭医院发票和诊断证明，可按实际费用报销，需部门负责人审批",
      "difficulty": "hard"
    },
    {
      "id": "RAG_007",
      "category": "policy_query",
      "query": "出差补贴怎么算？",
      "expected_chunks": [
        "daily_allowance_policy",
        "subsidy_calculation_rules"
      ],
      "ground_truth_answer": "出差补贴按自然日计算：国内100元/天，国际200元/天，不足一天按实际小时计算",
      "difficulty": "easy"
    },
    {
      "id": "RAG_008",
      "category": "complex_scenario",
      "query": "我要从北京出差到上海3天，然后去杭州2天，住宿怎么报销？",
      "expected_chunks": [
        "multi_city_trip_policy",
        "accommodation_policy_standard",
        "city_tier_classification"
      ],
      "ground_truth_answer": "上海按一线城市标准500元/晚×3天，杭州按二线城市标准400元/晚×2天，总计2300元",
      "difficulty": "hard"
    },
    {
      "id": "RAG_009",
      "category": "policy_query",
      "query": "火车票可以买一等座吗？",
      "expected_chunks": [
        "train_class_policy",
        "travel_mode_selection"
      ],
      "ground_truth_answer": "经理及以上级别可购买一等座，普通员工购买二等座",
      "difficulty": "easy"
    },
    {
      "id": "RAG_010",
      "category": "time_constraint",
      "query": "出差报销有时间限制吗？",
      "expected_chunks": [
        "reimbursement_deadline",
        "expense_report_timeline"
      ],
      "ground_truth_answer": "出差结束后30个自然日内必须提交报销申请，逾期不予受理",
      "difficulty": "medium"
    },
